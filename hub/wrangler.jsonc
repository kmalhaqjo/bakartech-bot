{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bakartech-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *", "*/5 * * * *"] },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bakartech-hub-db",
      "database_id": "67877c6d-485d-457e-b31a-0ca6804470e3"
    },
    {
      "binding": "JOURNAL_DB",
      "database_name": "bakartech-journal-db",
      "database_id": "b53a3581-3a28-4b85-a335-62e001394b1d"
    },
    {
      "binding": "BOT_DB",
      "database_name": "bakartech-db",
      "database_id": "29c17797-1d19-4ec2-84f6-d11f19b0fc74"
    }
  ],
  "vars": {
    // Discord — bakartech Academy server / Bakartech Academy Bot
    "DISCORD_APP_ID": "1516479046480039976",
    "DISCORD_PUBLIC_KEY": "de7b930271b23ca3ddab140ce1ebb868518922e0a2f4a6f7f2ea00a11dc878e9",
    "DISCORD_GUILD_ID": "1516482561390678167",
    "DISCORD_VERIFIED_ROLE": "verified",
    "CH_INVITES": "1516499116362961281",
    "CH_ANNOUNCE": "1516499119923789824",
    "CH_ANALYSIS": "1516499184952541326",
    "CH_SCREENSHOTS": "1516499119923789824",
    "CH_JOURNAL": "1516499240539656254",
    "CH_LIVE_RESULTS": "1516499127842898003",

    // Daily analysis → Telegram channel Kamalhaqjo
    "ANALYSIS_TG_CHAT_ID": "-1003211477952",

    // Bakartech Journal app (accounts for new Discord members, daily summary, prop scoring)
    "JOURNAL_URL": "https://bakartech-journal-v2.pages.dev",
    "JOURNAL_NEW_LEVEL": "Student",

    // Notion «Bakartech Student System» (Command Center)
    "NOTION_STUDENTS_DB": "a3ec9d21c55f46d0919df4345a6bd048",
    "NOTION_ACTIVITIES_DB": "822cbf6551e24353bd467c8e49bde1e3",
    "NOTION_REWARDS_DB": "25d29d64a6c7484e9c800d9f25cec140",
    "NOTION_REVENUE_DB": "b0a93cb0b89f4250bfc251cd0050f70b"
  }
  // Secrets (set once in the Cloudflare dashboard → Settings → Variables and Secrets):
  //   DISCORD_BOT_TOKEN (required). Optional: GROQ_API_KEY,
  //   ANALYSIS_TG_BOT_TOKEN (bot that can post in the Telegram channel — daily analysis + journal summary),
  //   JOURNAL_ADMIN_PASSWORD (journal app admin password — lets the hub create student accounts),
  //   NOTION_TOKEN (Notion integration with access to «Bakartech Student System»)
}
