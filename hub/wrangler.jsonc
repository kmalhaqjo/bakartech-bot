{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bakartech-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bakartech-db",
      "database_id": "PUT_YOUR_D1_DATABASE_ID_HERE"
    }
  ],
  "vars": {
    // Telegram — @Bakartechbot (اوطاق شکار)
    "BOT_USERNAME": "Bakartechbot",
    "ADMIN_IDS": "909200283",
    "VIP_CHANNEL_ID": "-1003615555387",
    "SUPPORT_URL": "https://t.me/BakarSupport",
    "SKOOL_URL": "https://www.skool.com/bakartech-2284/about?ref=7789a6422dd8477b9d3d5cf4ec048434",

    // Discord — bakartech Academy server / Bakartech Academy Bot
    "DISCORD_APP_ID": "1516479046480039976",
    "DISCORD_PUBLIC_KEY": "de7b930271b23ca3ddab140ce1ebb868518922e0a2f4a6f7f2ea00a11dc878e9",
    "DISCORD_GUILD_ID": "1516482561390678167",
    "DISCORD_VERIFIED_ROLE": "verified",
    "CH_INVITES": "1516499116362961281",
    "CH_ANNOUNCE": "1516499119923789824",
    "CH_ANALYSIS": "1516499184952541326",
    "CH_SCREENSHOTS": "1516499119923789824",
    "CH_JOURNAL": "1516499240539656254",
    "CH_LIVE_RESULTS": "1516499127842898003",

    // Daily analysis → Telegram channel Kamalhaqjo
    "ANALYSIS_TG_CHAT_ID": "-1003211477952"
  }
  // Secrets (set once in the Cloudflare dashboard → Settings → Variables and Secrets):
  //   BOT_TOKEN, WEBHOOK_SECRET, DISCORD_BOT_TOKEN, GROQ_API_KEY, ANALYSIS_TG_BOT_TOKEN (optional)
}
